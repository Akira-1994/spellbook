{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spellbook/review-event.schema.json",
  "title": "Spellbook Review Event",
  "type": "object",
  "required": [
    "event_id", "schema_version", "editor_name", "occurred_at_utc",
    "spell_id", "action", "base_revision_hash", "changes",
    "completed_checks", "note"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^rev_[0-9A-HJKMNP-TV-Z]{26}$"},
    "schema_version": {"const": 1},
    "editor_name": {"type": "string", "minLength": 1},
    "occurred_at_utc": {"type": "string", "format": "date-time"},
    "spell_id": {"type": "string", "pattern": "^spl_[0-9A-HJKMNP-TV-Z]{26}$"},
    "spell_entry_id": {"type": ["string", "null"]},
    "action": {"enum": [
      "update_fields", "set_check", "approve_review", "resolve_conflict",
      "set_variant_group", "merge_spell", "resolve_duplicate", "revert_event"
    ]},
    "base_revision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "before", "after"],
        "properties": {"path": {"type": "string", "minLength": 1}, "before": {}, "after": {}},
        "additionalProperties": false
      }
    },
    "completed_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["names", "rules", "descriptions", "source"]}
    },
    "note": {"type": "string"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
